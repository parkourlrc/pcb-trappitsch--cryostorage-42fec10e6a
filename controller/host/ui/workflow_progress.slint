import { Const } from "consts.slint";
import {
    MyVerticalLayout,
    NormalText,
    H2Text,
    RegularButton,
    H3Text,
    H1Text,
    MyHorizontalLayout,
} from "elements.slint";
import { Palette } from "palette.slint";
import { KeyboardLogic } from "keyboard.slint";

export global ProgressWindowLogic {
    pure callback button_pressed();

    in-out property <string> title;
    in-out property <string> description;
    in-out property <string> message;
    in-out property <string> timer;
    in-out property <bool> error_mode;

    in-out property <string> button_text: "Cancel";
    in-out property <bool> button_enabled: false;
}

export component ProgressWindow inherits Window {
    y: 20px;

    // FIXME: Uncomment the following two lines
    // height: 760px;
    // width: 1170px;

    background: Palette.bg;
    no-frame: true;

    MyVerticalLayout {

        H1Text {
            text: ProgressWindowLogic.title;
            horizontal-alignment: center;
        }

        MyHorizontalLayout {
            alignment: center;
            H3Text {
                text: ProgressWindowLogic.description;
                font-italic: true;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }

        MyHorizontalLayout {
            alignment: center;
            H2Text {
                text: ProgressWindowLogic.message;
                wrap: word-wrap;
                horizontal-alignment: center;
                color: ProgressWindowLogic.error_mode ? Palette.red : Palette.text;
            }
        }

        if ProgressWindowLogic.timer != "": H3Text {
            text: "Remaining time:\n" + ProgressWindowLogic.timer;
            horizontal-alignment: center;
        }

        MyHorizontalLayout {
            alignment: center;
            padding-bottom: Const.border_spacing;

            RegularButton {
                enabled: ProgressWindowLogic.button_enabled;
                text: ProgressWindowLogic.button_text;
                clicked => {
                    ProgressWindowLogic.button_pressed();
                }
            }
        }
    }
}

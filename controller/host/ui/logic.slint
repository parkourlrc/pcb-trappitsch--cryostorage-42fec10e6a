import { Const } from "consts.slint";
import { Palette } from "palette.slint";

// Structs
export struct BakingTime {
    hours: int,
    minutes: int,
    seconds: int,
}

// Valve and pump states
export enum ValveOrPumpState { OpenOrOn, ClosedOrOff, UndefinedOrError, SetDifferentFromCalled }

// Pump stand states
export enum PumpStandStateGUI {
    Off,
    On,
    SpinningUp,
    SpinningDown,
    Error,
}

// Logic
export global Logic {
    // Overall workflows
    pure callback pump_chamber();
    pure callback vent_chamber();
    pure callback initiate_sample_transfer();

    // Baking
    in-out property <bool> baking_is_enabled;
    in-out property <BakingTime> baking_time: {
        hours: 0,
        minutes: 0,
        seconds: 0,
    };
    pure callback baking_enabled(bool);

    // Cryocooler
    pure callback cryocooler_set_on(bool);
    in-out property <bool> cryocooler_is_on;
    in-out property <float> max_temp_halfband: 150.0;  // above this temp, temp is red.

    // Flow meter
    in-out property <bool> water_flow_ok;

    // Light switch
    in-out property <bool> light_is_on;
    pure callback light_switch(bool);

    // Program
    pure callback close_program();
    in-out property <bool> admin_mode: false;
    pure callback enter_admin_mode();
    pure callback test_alarm_pressed();

    // Pumps
    in-out property <bool> ion_pump_is_on;
    pure callback ion_pump_set_on(bool);
    in-out property <bool> pump_stand_is_on;
    pure callback pump_stand_set_on(bool);

    // Samples
    pure callback edit_sample_name(string, string, string);
    in-out property <[{ pos: string, name: string, date_str: string }]> sample_model: [
        { pos: "A1", name: "", date_str: "" },
        { pos: "A2", name: "", date_str: "" },
        { pos: "B1", name: "", date_str: "" },
        { pos: "B2", name: "", date_str: "" },
        { pos: "C1", name: "", date_str: "" },
        { pos: "C2", name: "", date_str: "" },
        { pos: "D1", name: "", date_str: "" },
        { pos: "D2", name: "", date_str: "" },
    ];
    pure callback sample_swiped(string, Point, Point);

    out property <length> total_height: 400px;
    out property <length> total_width: Const.useable_width - 2 * Const.border_spacing;
    out property <color> border_color: Palette.overlay2;
    out property <length> border_width: 2px;

    // Temperature: Note: A temperature of 0 represents an ERROR state
    in-out property <int> sample_temp; // K
    in-out property <int> bridge_temp; // K
    in-out property <int> cooler_temp; // K
    in property <image> temperature_plot;
    in property <int> target_temp; // K
    in property <int> heater_output;
    in property <int> cryocooler_power; // W
    pure callback set_setpoint_temp();

    // Vacuum
    pure callback chamber_gauge_set_on(bool);
    in-out property <bool> chamber_gauge_is_on;
    in-out property <string> chamber_pressure;

    pure callback transfer_gauge_set_on(bool);
    in-out property <bool> transfer_gauge_is_on;
    in-out property <string> transfer_pressure;

    in property <image> vacuum_plot;

    // Valves: callbacks and button settings indicators
    pure callback transfer_valve_set_open(bool);
    in-out property <bool> transfer_valve_is_open;
    pure callback pump_valve_set_open(bool);
    in-out property <bool> pump_valve_is_open;
    pure callback vent_valve_set_open(bool);
    in-out property <bool> vent_valve_is_open;

    // Valve and pump states: for status indicator
    in-out property <ValveOrPumpState> transfer_valve_state: ValveOrPumpState.UndefinedOrError;
    in-out property <ValveOrPumpState> pump_valve_state: ValveOrPumpState.UndefinedOrError;
    in-out property <PumpStandStateGUI> pump_stand_state: PumpStandStateGUI.Error;
    in-out property <ValveOrPumpState> vent_valve_state: ValveOrPumpState.UndefinedOrError;
    in-out property <ValveOrPumpState> ion_pump_state: ValveOrPumpState.UndefinedOrError;

    // VCT attached status: displays green box around VCT if attached
    in-out property <bool> is_vct_attached: true;

    // Hanlde signal to Leica for VCT attachment
    in-out property <bool> ready_vct_attach: false;
    pure callback send_ready_vct_attach(bool);

    // Logging
    in-out property <[string]> log_messages: [];
}

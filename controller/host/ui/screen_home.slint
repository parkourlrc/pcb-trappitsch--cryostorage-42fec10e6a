import { MyWindow } from "elements.slint";

import { Const } from "consts.slint";
import {
    BigButton,
    BigSwitch,
    NormalText,
    LongButton,
    LightSwitch,
    SmallSwitch,
    InfoArea,
    PictogramButton,
    StatusOkErr,
    InfoAreaSmall,
    MyVerticalLayout,
    MyHorizontalLayout,
    H2Text,
    H3Text,
} from "elements.slint";
import { Palette } from "palette.slint";
import { Samples } from "samples.slint";
import { Logic } from "logic.slint";

export component HomeScreen inherits MyWindow {
    index: 0;

    MyVerticalLayout {

        MyHorizontalLayout {

            InfoArea {
                title: "Sample temperature";
                title_color: Palette.rosewater;
                text_color: (Logic.sample_temp > 0 && Logic.sample_temp < (Logic.target_temp + Logic.max_temp_halfband)) ? Palette.blue : Palette.red;
                text: (Logic.sample_temp == 0) ? "Error" : Logic.sample_temp + " K";
            }

            InfoAreaSmall {
                title: "Chamber";
                title_color: Palette.sky;
                text: Logic.chamber_pressure;
            }

            InfoAreaSmall {
                title: "Transfer";
                title_color: Palette.yellow;
                text: Logic.transfer_pressure;
            }
        }

        MyHorizontalLayout {

            MyHorizontalLayout {
                alignment: start;
                padding-left: 0px;
                padding-right: 0px;

                BigButton {
                    enabled: true;  // no need for admin mode
                    text: "Start Sample Transfer";
                    clicked() => {
                        Logic.initiate_sample_transfer();
                    }
                }

                Rectangle {
                    width: Const.element_width_wide;
                    height: Const.big_switch_height;

                    background: Palette.bg_area;
                    border_radius: Const.border_radius_large;

                    VerticalLayout {
                        padding: Const.padding_large;
                        H2Text {
                            text: "Vacuum Chamber";
                            horizontal-alignment: center;
                        }

                        HorizontalLayout {
                            alignment: space-between;

                            Rectangle {
                                width: 47%;
                                height: 35%;

                                border-radius: Const.border_radius_small;

                                ta_vent := TouchArea {
                                    clicked => {
                                        Logic.vent_chamber()
                                    }
                                }

                                background: ta_vent.pressed ? Palette.button_on : Palette.button_off;

                                H3Text {
                                    text: "Vent";
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    color: Palette.text;
                                }
                            }

                            Rectangle {
                                width: 47%;
                                height: 35%;

                                border-radius: Const.border_radius_small;

                                ta_pump := TouchArea {
                                    clicked => {
                                        Logic.pump_chamber()
                                    }
                                }

                                background: ta_pump.pressed ? Palette.button_on : Palette.button_off;

                                H3Text {
                                    text: "Pump";
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    color: Palette.text;
                                }
                            }
                        }
                    }
                }
                // BigSwitch {
                //     enabled: true;  // no need for admin mode
                //     title: "Vacuum Chamber";
                //     right_side: Logic.chamber_is_pumped;
                //     left_text: "Vent";
                //     right_text: "Pump";
                //     switched(set_pumped) => {
                //         Logic.set_chamber_is_pumped(set_pumped);  // bool
                //     }
                // }
            }

            LightSwitch {
                activated: Logic.light_is_on;
                clicked(val) => {
                    Logic.light_switch(val);
                }
            }
        }

        Samples { }
    }
}

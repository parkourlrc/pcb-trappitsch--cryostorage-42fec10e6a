FROM rust:1-bookworm

ENV DEBIAN_FRONTEND=noninteractive

RUN dpkg --add-architecture arm64 && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        pkgconf \
        pkg-config \
        cmake \
        make \
        g++ \
        clang \
        lld \
        git \
        file \
        ca-certificates \
        gcc-aarch64-linux-gnu \
        g++-aarch64-linux-gnu \
        libc6-dev-arm64-cross \
        libudev-dev:arm64 \
        libseat-dev:arm64 \
        libxkbcommon-dev:arm64 \
        libinput-dev:arm64 \
        libgbm-dev:arm64 \
        libdrm-dev:arm64 \
        libegl1-mesa-dev:arm64 \
        libgles2-mesa-dev:arm64 \
        libfontconfig1-dev && \
    rm -rf /var/lib/apt/lists/*

RUN rustup target add aarch64-unknown-linux-gnu

RUN printf '%s\n' \
    '#!/bin/sh' \
    'exec pkg-config "$@"' \
    > /usr/local/bin/aarch64-linux-gnu-pkg-config && \
    chmod +x /usr/local/bin/aarch64-linux-gnu-pkg-config

ENV CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc
ENV CXX_aarch64_unknown_linux_gnu=aarch64-linux-gnu-g++
ENV AR_aarch64_unknown_linux_gnu=aarch64-linux-gnu-ar
ENV CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER=aarch64-linux-gnu-gcc
ENV PKG_CONFIG_ALLOW_CROSS=1
ENV PKG_CONFIG_aarch64_unknown_linux_gnu=/usr/local/bin/aarch64-linux-gnu-pkg-config
ENV PKG_CONFIG_PATH_aarch64_unknown_linux_gnu=/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig
ENV PKG_CONFIG_LIBDIR_aarch64_unknown_linux_gnu=/usr/lib/aarch64-linux-gnu/pkgconfig:/usr/share/pkgconfig
ENV PKG_CONFIG_SYSROOT_DIR_aarch64_unknown_linux_gnu=/
ENV RUST_FONTCONFIG_DLOPEN=on

WORKDIR /work/controller/host

CMD ["cargo", "build", "--release", "--target", "aarch64-unknown-linux-gnu"]
